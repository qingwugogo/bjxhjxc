.toolbar-row {
  margin-top: 12rpx;
}

.picker-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: 72rpx;
  font-size: 25rpx;
  color: #374151;
}

.arrow {
  color: #9ca3af;
  margin-left: 8rpx;
  font-size: 22rpx;
}

.order-row {
  align-items: center;
}

.detail-arrow {
  margin-left: 12rpx;
  color: #9ca3af;
  font-size: 24rpx;
  flex-shrink: 0;
}

.is-net { color: #047857; }
.is-loss { color: #b91c1c; }
