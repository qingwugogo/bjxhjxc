.upload {
  margin-top: 20rpx;
  height: 420rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #d5d8e2;
  background: #fafbfe;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-img {
  width: 100%;
  height: 100%;
}

.upload-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cam {
  width: 96rpx;
  height: 72rpx;
  border-radius: 14rpx;
  border: 4rpx solid #c7cbd6;
  position: relative;
  margin-bottom: 20rpx;
}

.cam::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 34rpx;
  height: 34rpx;
  margin: -17rpx 0 0 -17rpx;
  border-radius: 50%;
  border: 4rpx solid #c7cbd6;
}

.cam::after {
  content: "";
  position: absolute;
  left: 50%;
  top: -12rpx;
  width: 36rpx;
  height: 12rpx;
  margin-left: -18rpx;
  background: #c7cbd6;
  border-radius: 6rpx 6rpx 0 0;
}

.upload-tip {
  font-size: 27rpx;
  color: #4b5563;
}

.upload-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 20rpx -8rpx 0;
}

.grid-cell {
  width: 50%;
  padding: 0 8rpx;
  margin-bottom: 18rpx;
}

.grid-cell.full { width: 100%; }

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  display: block;
  font-size: 23rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.field-input {
  width: 100%;
  height: 76rpx;
  padding: 0 18rpx;
  background: #f7f8fb;
  border: 1rpx solid #e5e7eb;
  border-radius: 14rpx;
  font-size: 27rpx;
  color: #111827;
}

.pick-link {
  font-size: 22rpx;
  color: #4338ca;
  padding: 0 8rpx 8rpx;
}

.mono {
  font-family: "SF Mono", Menlo, Consolas, monospace;
}

/* ---------- 渠道下拉（picker 样式与输入框一致） ---------- */
.field-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #111827;
}

.field-picker .arrow {
  color: #9ca3af;
  font-size: 24rpx;
  margin-left: 10rpx;
}
